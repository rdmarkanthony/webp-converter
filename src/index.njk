---
layout: base.njk
title: WebP Converter — Convert images to WebP in your browser
pageDescription: Convert JPG, PNG, GIF, BMP, AVIF and SVG images to WebP for free. Files never leave your device.
---

<section class="px-4 pt-10 pb-6 md:pt-16">
    <div class="container mx-auto max-w-4xl text-center">
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900">Convert images to WebP</h1>
        <p class="mt-3 text-base md:text-lg text-slate-600">Fast, free and private. Everything runs in your browser — your images are never uploaded.</p>
    </div>
</section>

<section class="px-4 pb-16" data-converter>
    <div class="container mx-auto max-w-4xl">
        {# drop zone #}
        <label data-dropzone class="group flex flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-slate-300 bg-white px-6 py-12 text-center cursor-pointer transition-colors hover:border-indigo-400 hover:bg-indigo-50/40 data-[dragging]:border-indigo-500 data-[dragging]:bg-indigo-50 focus-within:outline-2 focus-within:outline-indigo-500">
            <svg class="size-12 text-slate-400 group-hover:text-indigo-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
            </svg>
            <span class="text-lg font-semibold text-slate-800">Drop images here or <span class="text-indigo-600 underline underline-offset-4">browse</span></span>
            <span class="text-sm text-slate-500">JPG, PNG, GIF, BMP, AVIF, SVG · You can also paste from clipboard</span>
            <input data-file-input type="file" accept="image/*" multiple class="sr-only" />
        </label>

        <p data-support-warning hidden class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200">
            Your browser can't encode WebP images. Please use a recent version of Chrome, Edge or Firefox.
        </p>

        {# settings #}
        <div class="mt-6 grid gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200 md:grid-cols-[1fr_auto_auto] md:items-end">
            <div>
                <label for="quality" class="flex items-center justify-between text-sm font-medium text-slate-700">
                    <span>Quality</span>
                    <output data-quality-output for="quality" class="tabular-nums text-slate-900">80</output>
                </label>
                <input data-quality id="quality" type="range" min="1" max="100" value="80" class="mt-2 w-full accent-indigo-600" />
            </div>
            <div>
                <label for="max-width" class="block text-sm font-medium text-slate-700">Max width <span class="font-normal text-slate-400">(px)</span></label>
                <input data-max-width id="max-width" type="number" min="1" inputmode="numeric" placeholder="Original" class="mt-2 w-full md:w-32 rounded-lg border-0 px-3 py-2 text-sm ring-1 ring-slate-300 focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label for="max-height" class="block text-sm font-medium text-slate-700">Max height <span class="font-normal text-slate-400">(px)</span></label>
                <input data-max-height id="max-height" type="number" min="1" inputmode="numeric" placeholder="Original" class="mt-2 w-full md:w-32 rounded-lg border-0 px-3 py-2 text-sm ring-1 ring-slate-300 focus:ring-2 focus:ring-indigo-500" />
            </div>
        </div>

        {# results #}
        <div data-results hidden class="mt-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <p data-summary class="text-sm text-slate-600" aria-live="polite"></p>
                <div class="flex gap-2">
                    <button data-clear type="button" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-slate-300 hover:bg-slate-100 transition-colors">Clear</button>
                    <button data-download-all type="button" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50 disabled:pointer-events-none transition-colors">Download all (.zip)</button>
                </div>
            </div>
            <ul data-list class="mt-4 grid gap-3"></ul>
        </div>

        <template data-item-template>
            <li class="flex items-center gap-4 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                <img data-thumb alt="" class="size-16 shrink-0 rounded-lg bg-slate-100 object-contain" />
                <div class="min-w-0 flex-1">
                    <p data-name class="truncate text-sm font-medium text-slate-900"></p>
                    <p data-meta class="mt-1 text-xs text-slate-500"></p>
                </div>
                <span data-badge class="hidden shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums sm:inline-block"></span>
                <a data-download class="shrink-0 rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 aria-disabled:opacity-40 aria-disabled:pointer-events-none transition-colors" aria-disabled="true">Download</a>
                <button data-remove type="button" class="shrink-0 rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors" aria-label="Remove">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </li>
        </template>
    </div>
</section>
