---
layout: base.njk
title: WebP Converter | Convert images to WebP in your browser
pageDescription: Convert JPG, PNG, GIF, BMP, AVIF and SVG images to WebP for free. Files never leave your device.
---

<section class="pt-2 pb-6 md:pt-6 md:pb-8">
    <div class="container-1">
        <h1 class="text-balance font-display font-semibold text-[2rem] md:text-5xl leading-[1.05] tracking-[-0.035em]">
            Convert images to <span class="text-theme-accent">WebP</span>.
        </h1>
        <p class="mt-2 text-base md:text-lg text-theme-muted">Smaller files, same look. Runs in your browser, nothing is uploaded.</p>
    </div>
</section>

<section class="pb-20" data-converter>
    <div class="container-1">
        <div class="p-3 md:p-4 border border-theme-line rounded-3xl bg-theme-surface/60 backdrop-blur-xl">
            {# drop zone #}
            <label data-dropzone class="group flex flex-col items-center justify-center gap-3 px-6 py-10 md:py-16 border border-dashed border-theme-line rounded-2xl text-center cursor-pointer transition-colors duration-300 hover:border-theme-accent data-[dragging]:border-theme-accent data-[dragging]:bg-theme-accent/10 focus-within:border-theme-accent">
                <span class="flex items-center justify-center size-14 rounded-full bg-theme-accent/15 text-theme-accent transition-transform duration-500 ease-out-expo group-hover:-translate-y-1">
                    <svg class="w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 16V4M12 4L7 9M12 4L17 9M4 15V18A2 2 0 0 0 6 20H18A2 2 0 0 0 20 18V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span class="font-display font-semibold text-xl md:text-2xl tracking-tight">
                    Drop images anywhere or
                    <span class="text-theme-accent underline decoration-1 underline-offset-4">browse</span>
                </span>
                <span class="text-sm text-theme-muted">JPG, PNG, GIF, BMP, AVIF, SVG · or paste from clipboard</span>
                <input data-file-input type="file" accept="image/*,.heic,.heif" multiple class="sr-only" />
            </label>

            {# settings, images convert as soon as they're added or the quality changes #}
            <div class="flex items-center gap-4 px-2 pt-5 pb-2 md:px-3">
                <label for="quality" class="text-sm text-theme-muted">Quality</label>
                <input data-quality id="quality" type="range" min="1" max="100" value="80" class="range flex-1" />
                <output data-quality-output for="quality" class="w-8 text-right text-sm font-medium tabular-nums">80</output>
            </div>
        </div>

        <p data-support-warning hidden class="mt-4 px-5 py-3 border border-amber-500/30 rounded-2xl bg-amber-500/10 text-sm text-amber-600 light:text-amber-700">Your browser is too old to convert images to WebP. Please update it, or use a recent version of Chrome, Edge, Firefox or Safari.</p>

        {# results #}
        <div data-results hidden class="mt-10">
            {# main action, the per-image downloads below stay secondary; sticks to the top while scrolling the list #}
            <div class="sticky top-3 z-20 rounded-3xl bg-theme-bg/85 shadow-lg shadow-theme-accent/10 backdrop-blur-xl">
                <div class="flex flex-col gap-4 p-4 md:p-5 border border-theme-accent/30 rounded-3xl bg-theme-accent/5 sm:flex-row sm:items-center sm:justify-between">
                    <p data-summary class="text-sm text-theme-muted" aria-live="polite"></p>
                    <div class="flex items-center gap-2">
                        <button data-clear type="button" class="btn h-12 px-5 text-sm text-theme-muted hover:text-theme-text">Clear</button>
                        <button data-download-all type="button" class="btn btn-primary flex-1 h-12 px-6 shadow-lg shadow-theme-accent/25 sm:flex-none">
                            <svg class="w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4V16M12 16L7 11M12 16L17 11M4 20H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <span data-download-all-label>Download all</span>
                        </button>
                    </div>
                </div>
            </div>
            <ul data-list class="mt-4 grid gap-2"></ul>
        </div>

        <template data-item-template>
            <li class="flex min-w-0 items-center gap-3 md:gap-4 p-2.5 pr-3 border border-theme-line rounded-2xl bg-theme-surface/60 backdrop-blur-xl">
                <img data-thumb alt="" class="size-14 shrink-0 rounded-xl bg-theme-line/50 object-cover" />
                <div class="min-w-0 flex-1">
                    <p data-name class="truncate text-sm font-medium"></p>
                    <p data-meta class="mt-0.5 text-xs text-theme-muted"></p>
                    <a data-download-webp hidden class="text-xs text-theme-accent underline underline-offset-2 hover:text-theme-accent-hover">Download WebP anyway</a>
                </div>
                <span data-badge class="hidden shrink-0 px-2.5 py-1 rounded-full text-xs font-medium tabular-nums"></span>
                <a data-download class="btn btn-outline shrink-0 h-9 px-4 text-sm aria-disabled:opacity-30 aria-disabled:pointer-events-none" aria-disabled="true">Download</a>
                <button data-remove type="button" class="flex shrink-0 items-center justify-center size-9 rounded-full text-theme-muted cursor-pointer transition-colors duration-300 hover:bg-theme-line hover:text-theme-text" aria-label="Remove">
                    <svg class="w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </li>
        </template>
    </div>
</section>
