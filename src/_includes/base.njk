{%- from "templates/header.njk" import header -%}
{%- from "templates/footer.njk" import footer -%}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ title | default('Home') | safe }}</title>
    {% if pageDescription -%}
    <meta name="description" content="{{ pageDescription }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    {%- endif %}
    <meta name="theme-color" content="#0c0c0e" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@200..800&family=DM+Sans:wght@100..1000&display=swap" />

    <script>
        // before paint, avoids a theme flash
        try {
            const saved = localStorage.getItem("theme");
            // dark unless the visitor picked light with the toggle
            document.documentElement.dataset.theme = saved === "light" ? "light" : "dark";
        } catch {
            document.documentElement.dataset.theme = "dark";
        }
    </script>

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
    <link rel="icon" type="image/png" href="/assets/favicon/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="stylesheet" href="/assets/css/style.css" media="all" />
    {% block styles -%}{%- endblock %}

    {% block headerscript -%}{%- endblock %}
</head>
<body>
    <canvas data-background class="fixed inset-0 -z-10 size-full pointer-events-none opacity-0 transition-opacity duration-1000" aria-hidden="true"></canvas>
    {{ header() }}
    <div class="main-content min-h-[calc(100vh-var(--header-height,0rem)-var(--footer-height,0rem))]">
        {{ content | safe }}
    </div>
    {% block popup -%}{%- endblock %}
    {{ footer() }}

    <script src="/assets/js/script.js" type="module"></script>
    {% block footerscript -%}{%- endblock %}
</body>
</html>